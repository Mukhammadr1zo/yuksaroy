# Prod .env namunasi. Serverda /opt/yuksaroy/.env sifatida saqlanadi (chmod 600, git ga kirmaydi).
# Har bir sirni yangidan yarating: openssl rand -base64 48

# ── domen ──
DOMAIN=yuksaroy.uz
NEXT_PUBLIC_SITE_URL=https://yuksaroy.uz
WEB_ORIGIN=https://yuksaroy.uz
WEB_URL=https://yuksaroy.uz
API_PUBLIC_URL=https://yuksaroy.uz
TG_APP_URL=https://yuksaroy.uz/tg

# ── baza (compose ichidagi db xizmati) ──
POSTGRES_USER=yuksaroy
POSTGRES_PASSWORD=
POSTGRES_DB=yuksaroy
DATABASE_URL=postgresql://yuksaroy:PAROL@db:5432/yuksaroy?schema=public

# ── sirlar ──
# DIQQAT: JWT_SECRET faqat token imzosi emas, OTP kodlari ham shu bilan xeshlanadi.
# Uni almashtirish yuborilgan kodlarni bekor qiladi (foydalanuvchi qaytadan kod so'raydi).
JWT_SECRET=
INTERNAL_SECRET=
# Swagger yopiq bo'lsin: token berilmasa /docs prodda umuman ochilmaydi
DOCS_TOKEN=

# ── Telegram (prod uchun alohida bot: dev bot bilan bitta token ishlatilsa 409 va OTP to'xtaydi) ──
BOT_TOKEN=
BOT_USERNAME=yuksaroy_bot
NEXT_PUBLIC_BOT_USERNAME=yuksaroy_bot

# ── xizmatlar ──
TRUST_PROXY=1
API_PORT=4000
API_INTERNAL_URL=http://api:4000
API_URL=http://api:4000
PLATFORM_ADMIN_PHONES=+998901234567

# ── ixtiyoriy ──
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
PREMIUM_PAY_DETAILS=
ANTHROPIC_API_KEY=
