# API: NestJS + Prisma. Monorepo ildizidan quriladi: docker build -f deploy/Dockerfile.api .
FROM node:24-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
ENV PNPM_HOME=/pnpm PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

# ── bog'liqliklar (lockfile o'zgarmasa qatlam keshdan olinadi) ──
FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/bot/package.json apps/bot/
COPY packages/domain/package.json packages/domain/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

# ── build ──
FROM deps AS build
COPY packages/domain packages/domain
COPY apps/api apps/api
RUN pnpm --filter @yuksaroy/domain build \
 && pnpm --filter @yuksaroy/api exec prisma generate \
 && pnpm --filter @yuksaroy/api build \
 && pnpm prune --prod

# ── ishga tushirish ──
FROM base AS run
ENV NODE_ENV=production
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/packages/domain packages/domain
COPY --from=build /app/apps/api/node_modules apps/api/node_modules
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/apps/api/prisma apps/api/prisma
COPY --from=build /app/apps/api/package.json apps/api/package.json
WORKDIR /app/apps/api
# Yuklangan fayllar volume'da: konteyner almashsa ham qoladi
RUN mkdir -p uploads && chown -R node:node uploads
USER node
EXPOSE 4000
# Migratsiya har ishga tushishda qo'llanadi (deploy: prisma migrate deploy), keyin server
CMD ["sh", "-c", "node ../../node_modules/prisma/build/index.js migrate deploy && node dist/main.js"]
