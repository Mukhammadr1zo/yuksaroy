# Telegram bot: Telegraf, uzoq polling. Monorepo ildizidan: docker build -f deploy/Dockerfile.bot .
FROM node:24-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/bot/package.json apps/bot/
COPY packages/domain/package.json packages/domain/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

FROM deps AS build
COPY packages/domain packages/domain
COPY apps/bot apps/bot
RUN pnpm --filter @yuksaroy/domain build \
 && pnpm --filter @yuksaroy/bot build \
 && pnpm deploy --filter=@yuksaroy/bot --prod /prod/bot

FROM base AS run
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /prod/bot ./
USER node
CMD ["node", "dist/bot.js"]
