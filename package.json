{
  "name": "yuksaroy",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d db redis minio",
    "db:migrate": "pnpm --filter @yuksaroy/api prisma:migrate",
    "db:studio": "pnpm --filter @yuksaroy/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
