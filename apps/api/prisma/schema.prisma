// YukSaroy: sxema v0.2 (identity + organizations + catalog). Enum'lar packages/domain bilan bir xil.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  FORWARDER
  DECLARANT
  CARRIER
  DRIVER
  TERMINAL_OPERATOR
  TERMINAL_ADMIN
  ASSET_OWNER
  LOCO_SERVICE
  JOB_SEEKER
  PLATFORM_OPERATOR
  PLATFORM_ADMIN
}

enum OrgKind {
  SHIPPER
  FORWARDER
  DECLARANT
  CARRIER
  TERMINAL
  ASSET_OWNER
  LOCO_SERVICE
  PLATFORM
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String        @id @default(cuid())
  phone         String?       @unique // E.164: +998901234567; Google orqali kirganda bo'sh bo'lishi mumkin
  email         String?       @unique
  googleSub     String?       @unique
  avatarUrl     String?
  fullName      String?
  locale        String        @default("uz")
  personalRoles Role[]        @default([]) // DRIVER, JOB_SEEKER: tashkilotsiz
  isActive      Boolean       @default(true)
  passwordHash  String? // argon2/bcrypt; bo'sh bo'lsa faqat kod yoki Google bilan kiradi
  passwordSetAt DateTime?     @db.Timestamptz(3)
  failedLogins  Int           @default(0) // PASSWORD.maxAttempts dan keyin lockedUntil
  lockedUntil   DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  telegram      TelegramLink?
  memberships   Membership[]
  sessions      Session[]
  listings      Listing[] // yakka haydovchi e'lonlari (ownerUserId)
  notifications Notification[]
  subscriptions Subscription[]
  serviceProfiles ServiceProfile[]
  marketRequests  MarketRequest[]
  wagonSearches   WagonSearch[]
  watches         Watch[]
}

/// Telefon ↔ Telegram chat bog'lanishi. OTP shu chatga yuboriladi (SMS yo'q).
model TelegramLink {
  userId   String   @id
  chatId   BigInt   @unique
  username String?
  linkedAt DateTime @default(now()) @db.Timestamptz(3)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Web'dan boshlangan kirish urinishi: telefon kiritildi → kod bot orqali yuboriladi.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  /// Bot deep-link tokeni: telefon hali botga bog'lanmagan bo'lsa, /start login_<token> bilan bog'lanadi
  linkToken  String?   @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
}

/// Refresh-token sessiyasi (rotation: har yangilashda yangi qator, eskisi revokedAt).
model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshHash  String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id             String       @id @default(cuid())
  kind           OrgKind // = kinds[0], eski kod uchun
  kinds          OrgKind[]    @default([])
  slug           String?      @unique
  name           String
  description    String?
  telegram       String?
  website        String?
  stir           String?      @unique // STIR/INN: 9 raqam
  kycStatus      KycStatus    @default(NONE)
  kycRequestedAt DateTime?    @db.Timestamptz(3)
  kycNote        String?
  /// Tasdiqlash uchun yuborilgan hujjatlar: [{ url, name, size, mime }]. Kamida bittasi shart.
  /// Faqat moderatsiya navbatida o'qiladi, umumiy orgSelect ga kirmaydi.
  kycDocs        Json?
  phone          String?
  address        String?
  regionCode     String? // viloyat kodi (ESR/SOATO): katalog filtrlari uchun
  storefront     Json? // /k/[slug] do'kon: { tagline, about, logoUrl, coverUrl, showListings, showTerminals, contactTelegram, contactPhonePublic }
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  members        Membership[]
  terminals      Terminal[]
  orders         Order[]      @relation("OrderShipper")
  documents      Document[]
  invoices       Invoice[]    @relation("InvoicePayer")
  supplied       Invoice[]    @relation("InvoiceSupplier")
  listings       Listing[]
  reviews        Review[]
  serviceProfiles ServiceProfile[]
  /// Namuna tashkilot: prodda saytni to'ldirish uchun, har joyda Namuna yorlig'i bilan
  isDemo         Boolean      @default(false)

  @@index([kind])
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  roles     Role[]
  isOwner   Boolean      @default(false)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Kim, nima, qachon: barcha muhim o'zgarishlar. Immutable.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // e.g. auth.login, org.create
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  /// Admin voronkasi: bitta amal turi bo'yicha oxirgi 30 kun
  @@index([action, createdAt])
}

// ───────────────────────── Katalog (S2) ─────────────────────────

enum Rju {
  TAS
  KOK
  BUX
  KUN
  KAR
  TER
}

/// Terminal turi transport bo'yicha. Shahobcha yo'l ham temir yo'l yuk terminali (RAIL).
enum TerminalKind {
  RAIL
  ROAD
  MULTI
}

enum TerminalStatus {
  DRAFT
  ACTIVE
  HIDDEN
}

enum ServiceCode {
  LOAD
  UNLOAD
  WEIGH
  STORAGE
  SVX
  CONTAINER
  LAST_MILE
  SHUNTING
}

enum TariffUnit {
  PER_TON
  PER_WAGON
  PER_OPERATION
  PER_DAY
}

enum ClaimStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

/// O'TY 2026 rasmiy stansiya reestri (276) + ESR kodi (6 raqam: 5 + nazorat) shahobcha reestridan.
model Station {
  id          String     @id @default(cuid())
  esrCode     String?    @unique
  nameUz      String
  nameRu      String?
  nameEn      String?
  rju         Rju
  stationType String? // passenger/freight/mixed/junction/yard/terminal/border/halt
  classRank   String? // 1..5, extra
  isTariff    Boolean    @default(true)
  /// Rasmiy ro'yxatda ("2026 yil stansiyalar") bormi. Xarita va katalogda faqat shular ko'rinadi;
  /// ro'yxatdan tashqari qatorlar o'chirilmaydi, chunki ularga obyekt bog'langan bo'lishi mumkin.
  /** Xaritada ko'rsatiladimi (rasmiy 2026 ro'yxati). Indeks migratsiyada yaratilgan. */
  isListed    Boolean    @default(true)
  lat         Float?
  lng         Float?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  terminals   Terminal[]
  orders      Order[]

  @@index([nameUz])
  @@index([rju])
  @@index([isListed])
}

/// ETSNG yuk pozitsiyalari (407): code..codeTo oralig'idagi yuk kodlari shu pozitsiyaga kiradi.
model CargoType {
  id        String  @id @default(cuid())
  code      String  @unique // pozitsiya kodi, 5 raqam
  codeTo    String
  name      String // ru (rasmiy)
  nameUz    String?
  groupCode String
  groupName String
  orders    Order[]

  @@index([name])
  @@index([groupCode])
}

/// Terminal pasporti. orgId bo'sh: jamoa ochiq ma'lumotdan kiritgan («claim your terminal»).
/// Shahobcha yo'l ham shu jadvalda: u temir yo'l yuk terminali (kind = RAIL), reestr
/// ma'lumoti pasport ustunlarida. Egasi da'vo qilib tasdiqlanmaguncha ownerNameRaw
/// va mas'ul shaxs telefoni ommaga ko'rsatilmaydi.
model Terminal {
  id          String            @id @default(cuid())
  orgId       String?
  org         Organization?     @relation(fields: [orgId], references: [id], onDelete: SetNull)
  /// Stansiya: reestrdan kelgan shahobchada stansiya topilmagan bo'lishi mumkin,
  /// o'shanda stationNameRaw qoladi va keyin bog'lanadi.
  stationId   String?
  // Restrict: stansiya o'chsa terminal pasportidan stansiya jimgina yo'qolmasin (migratsiyadagi FK ham shunday)
  station     Station?          @relation(fields: [stationId], references: [id], onDelete: Restrict)
  kind        TerminalKind
  slug        String            @unique
  name        String
  description String?
  address     String?
  phone       String?
  lat         Float?
  lng         Float?
  is24h       Boolean           @default(false)
  hours       Json? // { mon: [["08:00","18:00"]], ... }: is24h bo'lsa e'tiborsiz
  passport    Json? // { tracks, tracksLengthM, cranes: [{ type, capacityT }], warehouseM2, openAreaM2, hasSvx, hasScale }
  photos      String[]          @default([])
  status      TerminalStatus    @default(DRAFT)
  claimStatus ClaimStatus       @default(NONE) // terminal da'vosi: PENDING -> admin hal qiladi
  claimOrgId  String? // da'vo qilgan tashkilot; tasdiqlansa orgId ga ko'chadi
  claimedAt   DateTime?         @db.Timestamptz(3)
  /// Da'vo dalili: { note, files: [{ url, name, size, mime }] }. Faqat admin va da'vogar
  /// ko'radi, ochiq mapperlarda yo'q. Alohida jadval emas: dalil da'vodan ajralib yashamaydi.
  claimEvidence Json?
  regionCode  String? // viloyat (UZ-TK, UZ-TO, ...), koordinatadan hisoblanadi
  ratingAvg   Float             @default(0)
  ratingCount Int               @default(0)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  isDemo      Boolean           @default(false) // namuna terminal: sahifada "Namuna" belgisi, telefon yo'q
  slotConfig  Json? // { windows: [{ window, start, end, capacity }] }: slot generatsiyasi uchun

  // ─── Temir yo'l pasporti ───────────────────────────────────────────────
  // Shahobcha yo'l ham temir yo'l yuk terminali: reestr ma'lumoti shu yerda turadi.
  // Manba: Taminot reestri (taminot.d-railway.uz). RAIL va MULTI turlarida to'ladi.
  taminotId        Int?      @unique // import kaliti: qayta import qatorni takrorlamaydi
  registryNo       Int?      @unique // eski reestrdagi №
  registryRef      String? // reestr belgisi, masalan TASHKENT#3
  stationNameRaw   String? // reestrdagi stansiya nomi (bizning stansiyaga bog'lanmagan bo'lsa ham)
  esrCode          String?
  rju              Rju?
  ownerNameRaw     String? // reestrdagi yo'l egasi nomi
  lengthM          Int? // foydali uzunlik
  trackCount       Int? // yo'llar soni
  loadCapacity     Int       @default(0) // bir vaqtda yuklash, vagon
  unloadCapacity   Int       @default(0)
  capacityWagons   Int? // bir vaqtda sig'adigan vagon
  occupiedWagons   Int?
  deadEndDistanceM Int? // tupikkacha masofa
  junctionSwitch   String? // ulanish strelkasi raqami
  brakeShoes       Int? // tormoz boshmoqlari soni
  nogabarit        String? // negabarit yuk qabul qiladimi
  equipment        String? // uskunalar: ko'tarma yo'l, kran
  loadNorm         String?
  unloadNorm       String?
  loadFront        String?
  unloadFront      String?
  locoType         String? // RAILWAY (temir yo'l lokomotivi) yoki PRIVATE (o'ziniki)
  locoNote         String?
  processingHours  Float? // qayta ishlash vaqti, soat
  contractNo       String? // guvohnoma raqami
  contractStart    DateTime? @db.Date
  contractEnd      DateTime? @db.Date
  contractState    String? // SHARTNOMALI | SHARTNOMASIZ | BEKOR
  category         String? // GENERAL | METAL
  usageType        String? // PUBLIC | PRIVATE
  operStatus       String? // reestrdagi holat: FAOL | TAMIRDA | YOPIQ
  note             String?
  // Mas'ul shaxs: telefon faqat ro'yxatdan o'tgan foydalanuvchiga beriladi (e'lonlardagi qoida).
  contactName      String?
  contactPhone     String?

  services    TerminalService[]
  tariffs     Tariff[]
  slots       TimeSlot[]
  orders      Order[]
  listings    Listing[]
  reviews     Review[]
  inquiries   Inquiry[]

  @@index([stationId])
  @@index([status, kind])
  @@index([claimStatus])
  @@index([esrCode])
}

model TerminalService {
  id          String      @id @default(cuid())
  terminalId  String
  terminal    Terminal    @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  serviceCode ServiceCode
  isEnabled   Boolean     @default(true)
  leadTimeMin Int         @default(0)

  @@unique([terminalId, serviceCode])
}

/// Append-only tarif versiyalari. Amaldagi: validFrom <= now < validTo (yoki validTo null).
/// Migratsiyada EXCLUDE gist: bitta terminal × xizmat × yuk guruhi uchun davrlar kesishmaydi.
model Tariff {
  id             String      @id @default(cuid())
  terminalId     String
  terminal       Terminal    @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  serviceCode    ServiceCode
  cargoGroupCode String? // null: barcha yuklar uchun
  version        Int
  validFrom      DateTime    @db.Timestamptz(3)
  validTo        DateTime?   @db.Timestamptz(3)
  priceTiyin     BigInt
  unit           TariffUnit
  minTiyin       BigInt?
  note           String?
  createdById    String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([terminalId, serviceCode, version])
  @@index([terminalId, serviceCode, validFrom])
}

/// Platforma sozlamalari (komissiya, SLA, TTL). Kalitlar: packages/domain PLATFORM_DEFAULTS.
model PlatformConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// ───────────────────────── Booking + Orders (S3) ─────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum BookingStatus {
  HOLD
  CONFIRMED
  RELEASED
}

enum SlotStatus {
  OPEN
  CLOSED
}

enum Direction {
  LOCAL
  IMPORT
  EXPORT
}

enum CommissionPayer {
  CLIENT
  TERMINAL
}

/// Tayim-slot: terminal × kun (Toshkent vaqti) × oyna. Sig'im bitta raqam (7.4 #3).
/// Migratsiyada CHECK: booked >= 0, held >= 0, booked + held <= capacity.
model TimeSlot {
  id         String        @id @default(cuid())
  terminalId String
  terminal   Terminal      @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  localDate  DateTime      @db.Date // Toshkent kuni
  window     Int // 1..n, terminal sozlamasidagi oyna raqami
  startsAt   DateTime      @db.Timestamptz(3)
  endsAt     DateTime      @db.Timestamptz(3)
  capacity   Int
  booked     Int           @default(0)
  held       Int           @default(0)
  status     SlotStatus    @default(OPEN)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(3)
  bookings   SlotBooking[]

  @@unique([terminalId, localDate, window])
  @@index([terminalId, startsAt])
}

/// Slot bandligi: HOLD (10 daq) → CONFIRMED (buyurtma tasdiqlanganda) yoki RELEASED.
model SlotBooking {
  id            String        @id @default(cuid())
  slotId        String
  slot          TimeSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  userId        String
  orgId         String?
  orderId       String?       @unique
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  status        BookingStatus @default(HOLD)
  holdExpiresAt DateTime?     @db.Timestamptz(3)
  extendedOnce  Boolean       @default(false)
  confirmedAt   DateTime?     @db.Timestamptz(3)
  releasedAt    DateTime?     @db.Timestamptz(3)
  releaseReason String? // EXPIRED | CANCELLED | REJECTED | MANUAL
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  @@index([slotId, status])
  @@index([status, holdExpiresAt])
  @@index([userId, createdAt])
}

/// Buyurtma. Narx yaratilganda muzlatiladi (OrderItem.tariffId + unitPriceTiyin).
model Order {
  id              String               @id @default(cuid())
  no              String               @unique // YS-1041
  shipperOrgId    String
  shipperOrg      Organization         @relation("OrderShipper", fields: [shipperOrgId], references: [id])
  createdById     String
  terminalId      String
  terminal        Terminal             @relation(fields: [terminalId], references: [id])
  stationId       String
  station         Station              @relation(fields: [stationId], references: [id])
  direction       Direction            @default(LOCAL)
  operation       ServiceCode // LOAD | UNLOAD
  cargoTypeId     String?
  cargoType       CargoType?           @relation(fields: [cargoTypeId], references: [id])
  weightKg        Int
  wagonCount      Int                  @default(1)
  storageDays     Int?
  wagonNumbers    String[]             @default([]) // tushirishda mijoz kiritadi (F1 da qo'lda)
  note            String?
  subtotalTiyin   BigInt
  commissionPct   Int                  @default(0) // 300 = 3,00 %
  commissionPayer CommissionPayer      @default(TERMINAL)
  commissionTiyin BigInt               @default(0)
  totalTiyin      BigInt
  status          OrderStatus          @default(PENDING)
  slaConfirmUntil DateTime?            @db.Timestamptz(3)
  confirmedAt     DateTime?            @db.Timestamptz(3)
  closedAt        DateTime?            @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  items           OrderItem[]
  history         OrderStatusHistory[]
  documents       Document[]
  invoice         Invoice?
  booking         SlotBooking?

  @@index([shipperOrgId, createdAt])
  @@index([terminalId, status, slaConfirmUntil])
  @@index([status, slaConfirmUntil])
}

/// Buyurtma qatori: xizmat × miqdor × muzlatilgan tarif.
model OrderItem {
  id             String      @id @default(cuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceCode    ServiceCode
  tariffId       String? // muzlatilgan tarif versiyasi (nizoda "qaysi tarif bilan")
  qty            Float
  unit           TariffUnit
  unitPriceTiyin BigInt
  amountTiyin    BigInt
  minApplied     Boolean     @default(false)

  @@index([orderId])
}

/// Append-only: holat o'tishlari va ichki hodisalar (ARRIVED/WEIGHED/LOADED…).
model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  code       String? // ORDER_EVENT_CODES: ARRIVED | WEIGHED | LOADED | UNLOADED | DEPARTED | NO_SHOW
  actorId    String?
  actorRole  String? // CLIENT | TERMINAL | SYSTEM | ADMIN
  reason     String?
  payload    Json?
  at         DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orderId, at])
}

/// Takroriy POST himoyasi (Idempotency-Key). Javob keshlanadi, muddat 24 soat.
model IdempotencyKey {
  key       String   @id
  userId    String
  endpoint  String
  status    Int
  response  Json
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
}

// ── Hujjatlar va hisob (M5.1) ──
enum DocKind {
  ACT
  INVOICE
}

enum DocumentStatus {
  READY
  VOID
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID_OFFLINE
  OVERDUE
  VOID
}

/// Hujjat: PDF fayl saqlanmaydi, `payload` muzlatilgan ma'lumot va PDF har safar shundan chiziladi.
/// ponytail: fayl ombori (MinIO) F2 da; hozir bitta manba yetarli va hujjat hech qachon eskirmaydi.
model Document {
  id        String         @id @default(cuid())
  no        String         @unique
  kind      DocKind
  status    DocumentStatus @default(READY)
  orgId     String
  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payload   Json
  sha256    String
  qrToken   String         @unique
  slaDueAt  DateTime?      @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  @@index([orgId, createdAt])
  @@index([orderId])
}

model Invoice {
  id             String        @id @default(cuid())
  no             String        @unique
  status         InvoiceStatus @default(DRAFT)
  orgId          String
  org            Organization  @relation("InvoicePayer", fields: [orgId], references: [id], onDelete: Cascade)
  supplierOrgId  String?
  supplier       Organization? @relation("InvoiceSupplier", fields: [supplierOrgId], references: [id], onDelete: SetNull)
  orderId        String?       @unique
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amountTiyin    BigInt
  vatTiyin       BigInt        @default(0)
  dueAt          DateTime      @db.Timestamptz(3)
  paidAt         DateTime?     @db.Timestamptz(3)
  paidMarkedById String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  @@index([orgId, status])
  @@index([status, dueAt])
}

// ───────────────────────── E'lonlar (texnika va avtotransport) ─────────────────────────

enum ListingKind {
  SHUNTING_LOCO
  WAGON
  TRUCK
}

enum DealKind {
  RENT
  SALE
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED
  EXPIRED
}

enum Condition {
  NEW
  GOOD
  NEEDS_REPAIR
}

enum PriceUnit {
  TOTAL
  PER_MONTH
  PER_DAY
  PER_HOUR
  PER_KM
  PER_TON
  PER_TRIP
}

/// E'lon: teplovoz / elektrovoz / vagon (ijara yoki sotuv) yoki avtotashuvchi. Qoidalar: packages/domain LISTING_RULES.
/// Migratsiyada CHECK: priceTiyin bo'lsa priceUnit shart;
/// listing_owner: orgId yoki ownerUserId (yakka haydovchi, faqat TRUCK) bo'lishi shart.
model Listing {
  id             String         @id @default(cuid())
  slug           String         @unique
  orgId          String?
  org            Organization?  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownerUserId    String? // yakka shaxs e'loni: tashkilotsiz
  ownerUser      User?          @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdById    String
  kind           ListingKind
  deal           DealKind? // TRUCK uchun null
  status         ListingStatus  @default(DRAFT)
  title          String
  description    String?
  regionCode     String
  terminalId     String?
  terminal       Terminal?      @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  lat            Float?
  lng            Float?
  priceTiyin     BigInt?
  priceUnit      PriceUnit?
  photos         String[]       @default([])
  year           Int?
  condition      Condition?
  model          String?
  qty            Int            @default(1)
  wagonType      String?
  capacityT      Int?
  truckType      String?
  tonnage        Int?
  fleetSize      Int?
  serviceRegions String[]       @default([])
  routes         Json? // [{ from, to }] viloyat kodlari
  contactPhone   String?
  premiumUntil   DateTime?      @db.Timestamptz(3)
  publishedAt    DateTime?      @db.Timestamptz(3)
  expiresAt      DateTime?      @db.Timestamptz(3)
  rejectReason   String?
  views          Int            @default(0)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  inquiries      Inquiry[]
  premiumOrders  PremiumOrder[]
  reviews        ListingReview[]
  /// Xizmatdan foydalanganlar bahosi (ListingReview dan qayta hisoblanadi)
  ratingAvg      Float?
  ratingCount    Int            @default(0)

  @@index([status, kind, regionCode])
  @@index([orgId, status])
  @@index([ownerUserId, status])
  @@index([terminalId])
  @@index([status, expiresAt])
  /// Namuna e'lon: haqiqiy taklif emas, sayt bo'sh ko'rinmasligi uchun; telefon berilmaydi
  isDemo      Boolean @default(false)
}

/// Narx so'rovi: e'lon egasiga xabar. status: OPEN | CLOSED (F1 da matn).
/// Yozishma. Mavzusi e'lon yoki terminal bo'ladi: aynan bittasi to'ladi.
/// Terminal ham qo'shildi, chunki katalogdagi obyekt egasiga oldin faqat telefon orqali
/// murojaat qilinardi, yozib qo'yish imkoni yo'q edi.
model Inquiry {
  id            String            @id @default(cuid())
  listingId     String?
  listing       Listing?          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  terminalId    String?
  terminal      Terminal?         @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  fromOrgId     String?
  fromUserId    String
  message       String
  status        String            @default("OPEN")
  /// Kimga yozilgani yaratilganda aniqlanadi va keyin o'zgarmaydi. Huquq tekshiruvi
  /// shu uch maydonga qaraydi, mavzuni qayta o'qimaydi: obyekt egasi almashsa ham
  /// eski yozishma ochilib qolmaydi.
  toOrgId       String?
  toUserId      String?
  /// Reestrdan kelgan terminalning egasi yo'q: bunday xabarga platforma javob beradi.
  toPlatform    Boolean           @default(false)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  /// Yozishmadagi oxirgi xabar: ro'yxat shu bo'yicha tartiblanadi
  lastMessageAt DateTime?         @db.Timestamptz(3)
  messages      InquiryMessage[]

  @@index([listingId, createdAt])
  @@index([terminalId, createdAt])
  @@index([fromUserId, createdAt])
  @@index([toOrgId, lastMessageAt])
  @@index([toUserId, lastMessageAt])
  @@index([toPlatform, lastMessageAt])
}

/// So'rov ichidagi yozishma: mijoz va xizmat ko'rsatuvchi shu yerda gaplashadi.
/// Kim o'qigani readBy da: bir so'rovda ikki tomon bor, alohida jadval ochilmaydi.
model InquiryMessage {
  id         String   @id @default(cuid())
  inquiryId  String
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromUserId String
  text       String
  /// Biriktirilgan fayllar: [{ url, name, size, mime }]. Alohida jadval emas, chunki
  /// fayl xabardan ajralib yashamaydi va hech qachon alohida qidirilmaydi.
  attachments Json    @default("[]")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  readBy     String[] @default([])

  @@index([inquiryId, createdAt])
}

/// Saytdagi bildirishnoma. Telegram xabari yuborilgan joyda shu yozuv ham qo'shiladi:
/// Telegramni bog'lamagan foydalanuvchi ham hodisani ko'radi.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'inquiry' | 'message' | 'orderNew' | 'orderStatus' | 'claim' | 'kyc' | 'premium' | 'market' | 'listing' | 'subscription'
  kind      String
  title     String
  body      String?
  /// Sayt ichidagi manzil (masalan /dashboard/inquiries/<id>)
  href      String?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt, createdAt])
}

// ── Ishonch va monetizatsiya (5-bosqich) ──

/// Bajarilgan buyurtma uchun bitta baho (orderNo unique). Terminal.ratingAvg/ratingCount shundan qayta hisoblanadi.
model Review {
  id         String       @id @default(cuid())
  orderNo    String       @unique
  terminalId String
  terminal   Terminal     @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  orgId      String // yuk egasi tashkiloti
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId     String
  rating     Int // 1..5
  text       String? // <= 1000 belgi
  reply      String? // terminal javobi
  excluded   Boolean      @default(false) // arms-length: buyurtmachi va terminal egasi bir tomon; sharh ko'rinadi, reytingga kirmaydi
  repliedAt  DateTime?    @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@index([terminalId, createdAt])
}

/// Ko'rsatishlar: kun va yuza bo'yicha yig'ilgan hisob, foydalanuvchi ma'lumoti yo'q.

/// E'lon uchun izoh: xizmatdan foydalangan odam qoldiradi.
/// Huquq: shu e'longa so'rov yozgan va egasi javob bergan bo'lishi kerak (haqiqiy aloqa izi).
/// Bir foydalanuvchi bitta e'longa bitta izoh yozadi; egasi bir marta javob bera oladi.
model ListingReview {
  id         String    @id @default(cuid())
  listingId  String
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId     String
  rating     Int // 1..5
  text       String? // <= 1000 belgi
  reply      String?
  repliedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([listingId, userId])
  @@index([listingId, createdAt])
}

model Impression {
  id       String   @id @default(cuid())
  kind     String // 'listing' | 'terminal' | 'org'
  targetId String
  day      DateTime @db.Date
  surface  String // 'list' | 'map' | 'detail' | 'compare' | 'bot' | 'contact'
  count    Int      @default(0)

  @@unique([kind, targetId, day, surface])
}

/// Kunlik tashriflar: bir kun va bir joy uchun bitta qator.
/// Xom yozuv saqlanmaydi: IP ham, sessiya ham, sahifa manzili ham yo'q, ya'ni
/// bu jadvaldan bitta odamni ajratib olib bo'lmaydi.
model Visit {
  id      String   @id @default(cuid())
  day     DateTime @db.Date
  country String // ISO 3166-1 alpha-2; aniqlanmasa "ZZ"
  /// "UZ-TK" ko'rinishida. NULL emas, bo'sh satr: Postgres da NULL lar bir-biriga
  /// teng emas va noyob indeks takror qatorlarni to'sa olmasdi.
  region  String
  count   Int      @default(0)

  /// day birinchi ustun: "oxirgi N kun" so'rovi shu indeksdan foydalanadi
  @@unique([day, country, region])
}

/// Premium buyurtmasi: hozircha qo'lda to'lov (manual), keyin Payme/Click.
model PremiumOrder {
  id          String    @id @default(cuid())
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  orgId       String?
  userId      String
  months      Int // 1..12
  amountTiyin BigInt
  status      String    @default("PENDING") // PENDING | PAID | CANCELLED
  provider    String? // 'manual'
  paidAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([listingId])
  @@index([status])
}

/// Foydalanuvchi obunasi. Premium bitta e'longa tegishli, obuna esa odamga: telefon
/// raqamini ko'rish, vagon qidiruvi kabi pullik imkoniyatlar shu bilan ochiladi.
/// To'lov hozircha qo'lda: admin tasdiqlaydi (PremiumOrder bilan bir xil yo'l).
model Subscription {
  id          String    @id @default(cuid())
  /// PAY-1042: odam to'lov izohiga shuni yozadi, operator ko'chirmadan shu bo'yicha topadi (pay_no_seq)
  no          String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  months      Int // 1..12
  /// Bu obuna nimani ochadi: domain dagi SUBSCRIPTION_GRANTS ro'yxatidan.
  /// Eski qatorlar migratsiyada ikkalasini ham oladi, ya'ni bugungi obunachilar hech
  /// narsa sezmaydi va kodda "eskimi yoki yangimi" degan shart kerak bo'lmaydi.
  grants      String[]  @default([])
  /// Qaysi tarifdan olingan. Tarif keyin o'zgarsa yoki o'chsa ham bu obuna o'z
  /// shartida qoladi: ruxsat va chegaralar qator ichiga KO'CHIRIB yoziladi.
  planId      String?
  plan        Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  /// Sotib olingan paytdagi chegaralar nusxasi. Bo'sh bo'lsa umumiy sozlama ishlaydi.
  limits      Json?
  amountTiyin BigInt
  status      String    @default("PENDING") // PENDING | ACTIVE | CANCELLED
  provider    String? // 'manual'
  /// Tasdiqlangan obunaning amal qilish oralig'i. Faol = ACTIVE va endsAt > hozir.
  startsAt    DateTime? @db.Timestamptz(3)
  endsAt      DateTime? @db.Timestamptz(3)
  paidAt      DateTime? @db.Timestamptz(3)
  /// Tugash eslatmasi yuborilgan vaqt. Bo'sh = hali yuborilmagan. Belgi yuborishdan
  /// oldin qo'yiladi: sikl qayta ishga tushsa ham odamga ikkinchi xabar ketmaydi.
  remindedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, endsAt])
  @@index([status])
}

/// /contact formasi xabari.
model ContactMessage {
  id          String    @id @default(cuid())
  name        String
  contact     String
  topic       String
  message     String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  /// Hal qilingani uchta ustun bilan: kim, qachon, nima qilingan.
  /// Alohida holat ustuni ataylab yo'q: handledAt bo'sh bo'lsa murojaat javobsiz.
  /// User ga bog'lanish yo'q (AuditLog.actorId kabi): hisob o'chirilsa qator qolsin.
  handledById String?
  handledAt   DateTime? @db.Timestamptz(3)
  handledNote String?
}

// ── Shoshilinch xizmat so'rovlari (/urgent) ──

/// Shoshilinch so'rov: teplovoz chaqirish, vagon ta'miri, kran. no = 'UR-' + urgent_no_seq (migratsiyada).
/// kind: URGENT_KINDS, status: URGENT_STATUSES (packages/domain). statusToken: ommaviy holat havolasi (narxsiz).
model UrgentRequest {
  id             String        @id @default(cuid())
  no             String        @unique
  kind           String // LOCO_CALL | WAGON_REPAIR | CRANE | OTHER
  regionCode     String
  lat            Float?
  lng            Float?
  stationName    String?
  wagonCount     Int?
  description    String // <= 2000 belgi
  contactPhone   String
  createdById    String
  orgId          String?
  status         String        @default("OPEN") // OPEN | AWARDED | CLOSED | CANCELLED
  awardedOfferId String?
  statusToken    String        @unique
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  offers         UrgentOffer[]

  @@index([status, regionCode])
  @@index([createdById])
}

/// Provayder taklifi: narx (tiyin) va yetib kelish vaqti (daqiqa). status: URGENT_OFFER_STATUSES.
model UrgentOffer {
  id             String        @id @default(cuid())
  requestId      String
  request        UrgentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerOrgId  String?
  providerUserId String
  priceTiyin     BigInt?
  etaMinutes     Int?
  message        String?
  status         String        @default("SENT") // SENT | AWARDED | DECLINED
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([requestId])
}

// ───────────────────────── Xizmatlar markazi va yuk bozori ─────────────────────────

/// Xizmatlar markazi: ekspeditor, tovar kassiri yoki hujjat mutaxassisi o'zini e'lon qiladi.
/// Listing emas: u texnika va avtotransport uchun, bu esa odamning xizmati.
model ServiceProfile {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId           String?
  org             Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  serviceType     String // FORWARDER | CASHIER | DOCS (domain SERVICE_TYPES)
  title           String
  description     String
  regions         String[]      @default([]) // qaysi viloyatlarda ishlaydi
  experienceYears Int?
  priceNote       String? // "kelishiladi", "1 hujjat 150 000 so'm" kabi erkin matn
  contactPhone    String? // raqamning o'zi obunachiga GET /contacts orqali
  status          String        @default("ACTIVE") // ACTIVE | HIDDEN | BLOCKED (BLOCKED: admin yashirgan, egasi qaytara olmaydi)
  isDemo          Boolean       @default(false)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([userId, serviceType]) // bir odamda har xizmat turidan bitta profil: tekshiruv bazada, poyga bo'lmaydi
  @@index([serviceType, status, createdAt])
  @@index([userId])
}

/// Bozor so'rovi: xizmat so'rovi (SERVICE) yoki yuk e'loni (CARGO). /urgent shaklida:
/// so'rov -> takliflar -> tanlash -> yopish. Maydonlar taxtaga qarab to'ladi.
model MarketRequest {
  id             String        @id @default(cuid())
  no             String        @unique // SR-1001 / CR-1001, market_no_seq dan
  board          String // SERVICE | CARGO
  serviceType    String? // SERVICE: FORWARDER | CASHIER | DOCS
  regionCode     String? // SERVICE: qayerda kerak; CARGO: yuklash viloyati (fromRegion bilan bir xil)
  fromRegion     String? // CARGO
  toRegion       String? // CARGO
  fromText       String? // CARGO: aniq manzil yoki stansiya
  toText         String?
  cargoName      String? // CARGO
  weightT        Float? // CARGO, tonna
  loadDate       DateTime?     @db.Date // CARGO: yuklash sanasi
  truckType      String? // CARGO: domain TRUCK_TYPES
  volumeM3       Float? // CARGO: hajm, m3
  trucksCount    Int? // CARGO: nechta mashina kerak
  paymentTerm    String? // CARGO: domain PAYMENT_TERMS
  title          String
  description    String
  contactPhone   String? // raqamning o'zi obunachiga GET /contacts orqali
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  orgId          String?
  status         String        @default("OPEN") // domain MARKET_STATUSES
  awardedOfferId String?
  statusToken    String        @unique // ochiq holat sahifasi uchun
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  offers         MarketOffer[]

  @@index([board, status, createdAt])
  @@index([board, fromRegion, toRegion])
  @@index([createdById])
}

model MarketOffer {
  id             String        @id @default(cuid())
  requestId      String
  request        MarketRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerUserId String
  providerOrgId  String?
  priceTiyin     BigInt?
  message        String?
  status         String        @default("SENT") // domain MARKET_OFFER_STATUSES
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([requestId, providerUserId]) // bir so'rovga bir ta'minotchidan bitta taklif
  @@index([providerUserId])
}

/// Vagon qidiruvi jurnali. Bepul urinishlar soni shundan sanaladi (wagonSearchFree),
/// natija ham saqlanadi: bir xil raqamni qayta so'rash tashqi API ga bormaydi.
model WagonSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wagonNo   String // faqat raqamlar
  found     Boolean
  result    Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([wagonNo, createdAt])
}

/// Kuzatuv: odam qidirganini topmasa shartni saqlab qo'yadi va mos narsa chiqqanda
/// xabar oladi. Bir odamda WATCH_MAX (10) tadan ko'p emas.
///
/// params oq ro'yxat bo'yicha yoziladi va oq ro'yxat bo'yicha o'qiladi (domen
/// paketidagi WATCH_FIELDS): qatorga qo'lda qo'shilgan begona shart mosligni
/// o'zgartira olmaydi. Terminal joyi bo'yicha kuzatuv yo'q.
model Watch {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CARGO | LISTING
  kind       String
  /// CARGO: { fromRegion?, toRegion?, truckType? }
  /// LISTING: { listingKind?, regionCode?, truckType?, deal? }
  params     Json
  /// Oxirgi yuborilgan payt. Bitta kuzatuvga kuniga bitta xabar shu bilan cheklanadi:
  /// bugun yuborilgan qator umuman o'qilmaydi.
  lastSentAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  /// Hodisa bo'yicha o'qish: tur + bugun yuborilmaganlar
  @@index([kind, lastSentAt])
  @@index([userId])
}

/// Foydalanuvchi shikoyati: e'lon, terminal, xizmat sahifasi, bozor so'rovi yoki buyurtma ustidan.
///
/// Nega ContactMessage emas: murojaat ochiq forma (kirmagan odam ham yuboradi) va unda
/// obyekt yo'q. Shikoyat esa aniq obyektga tegishli va kirgan odamdan keladi.
///
/// Bir odam bir obyektga bir marta: qoida BAZADA (@@unique), ya'ni ikki oyna barobar
/// yuborsa ham ikkinchisi yozilmaydi va oyna hisoblaydigan kod kerak emas.
///
/// User ga bog'lanish yo'q (ContactMessage.handledById va AuditLog.actorId kabi):
/// hisob o'chirilsa shikoyat qatori qolsin.
model Report {
  id           String    @id @default(cuid())
  reporterId   String
  targetKind   String // REPORT_TARGETS: listing | terminal | service | request | order
  targetId     String
  /// Obyekt nomi va sahifasi yuborilgan paytdagi holicha. Nega nusxa: obyekt o'chsa yoki
  /// yashirilsa ham admin nima haqida gap ketayotganini ko'radi, ro'yxat esa beshta
  /// jadvalga qayta bormaydi.
  targetTitle  String
  targetHref   String
  reason       String // REPORT_REASONS
  text         String
  status       String    @default("NEW") // REPORT_STATUSES: NEW | RESOLVED | DISMISSED
  /// Kim hal qildi va yakun izohi. Alohida holat ustuni kerak, chunki holat uchta:
  /// sana bo'sh yoki to'la ikkitasini ajrata olmaydi.
  resolvedById String?
  resolvedAt   DateTime? @db.Timestamptz(3)
  resolveNote  String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([reporterId, targetKind, targetId])
  @@index([status, createdAt])
}

/// Yon tomondagi reklama: platformaning o'zi sotadi va o'zi joylaydi.
///
/// Uchinchi tomon kodi, pikseli va kuzatuvchisi yo'q va bo'lmaydi: maxfiylik sahifasida
/// "reklama kuzatuvchilari yo'q" va "ma'lumot reklama uchun berilmaydi" deb yozilgan.
/// Shu yozuvni buzmaslik uchun reklama shunchaki bizning bazamizdagi qator bo'lib qoladi.
model AdPlacement {
  id           String   @id @default(cuid())
  /// Qaysi joyda chiziladi: domain dagi AD_PLACEMENTS ro'yxatidan
  placement    String
  title        String
  body         String?
  imageUrl     String?
  href         String
  /// Kim sotib oldi va qancha to'ladi. Faqat panelda ko'rinadi, ommaviy javobda yo'q.
  buyer        String?
  pricePaidSom Int      @default(0)
  status       String   @default("DRAFT") // AD_STATUSES: DRAFT | ACTIVE
  startsAt     DateTime @db.Timestamptz(3)
  endsAt       DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([placement, status, startsAt, endsAt])
}

/// Obuna tarifi: narxi, nimani ochishi va chegaralari. Admin yoki moderator yaratadi.
///
/// Nega jadval: ilgari bitta narx sozlamada turardi va "tarif" degan tushuncha umuman
/// yo'q edi. Yangi tarif qo'shish uchun kod, uchta tarjima fayli va deploy kerak edi.
///
/// Tarif YO'Q bo'lsa tizim eskicha ishlaydi: sozlamadagi narx va to'liq obuna. Ya'ni bu
/// jadval ustiga qo'yiladigan qatlam, majburiy bosqich emas.
model Plan {
  id            String   @id @default(cuid())
  /// Buyurtmada shu kod ketadi; nom o'zgarsa ham havolalar buzilmaydi
  code          String   @unique
  /// Nom va tavsif satrlari uch tilda: { uz, ru, en } va { uz: [], ru: [], en: [] }.
  /// Admin yozgan matnni next-intl tarjima qila olmaydi, shuning uchun bazada.
  name          Json
  features      Json
  priceMonthSom Int
  /// Nimani ochadi: SUBSCRIPTION_GRANTS ro'yxatidan
  grants        String[] @default([])
  /// Chegaralar: PLAN_LIMIT_KEYS dagi kalitlar. Bo'sh bo'lsa umumiy sozlama ishlaydi.
  limits        Json?
  maxMonths     Int      @default(12)
  sort          Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  subscriptions Subscription[]

  @@index([active, sort])
}
