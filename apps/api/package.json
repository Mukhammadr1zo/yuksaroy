{
  "name": "@yuksaroy/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node --env-file=../../.env node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node --env-file=../../.env node_modules/prisma/build/index.js migrate deploy",
    "prisma:studio": "node --env-file=../../.env node_modules/prisma/build/index.js studio",
    "test": "node --env-file-if-exists=../../.env node_modules/vitest/vitest.mjs run",
    "db:seed": "node --env-file=../../.env node_modules/tsx/dist/cli.mjs prisma/seed/seed.ts",
    "db:seed:demo": "node --env-file=../../.env node_modules/tsx/dist/cli.mjs prisma/seed/demo.ts",
    "db:build-data": "node --env-file=../../.env node_modules/tsx/dist/cli.mjs prisma/seed/build-data.ts",
    "db:build-railmap": "node --env-file=../../.env node_modules/tsx/dist/cli.mjs prisma/seed/build-railmap.ts",
    "backfill:region": "node --env-file=../../.env node_modules/tsx/dist/cli.mjs prisma/seed/backfill-region.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^8",
    "@fontsource/manrope": "^5.3.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0",
    "@yuksaroy/domain": "workspace:*",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "google-auth-library": "^11.0.2",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "xlsx": "^0.18.5"
  },
  "prisma": {
    "seed": "node --env-file=../../.env node_modules/tsx/dist/cli.mjs prisma/seed/seed.ts"
  }
}
