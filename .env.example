# API
DATABASE_URL=postgresql://yuksaroy:yuksaroy@localhost:5434/yuksaroy
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-32-chars-minimum-please
INTERNAL_SECRET=change-me-shared-between-api-and-bot
BOT_TOKEN=123456:telegram-bot-token
BOT_USERNAME=yuksaroy_bot
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Proksi ortida (nginx/CDN) bo'lsa: true, hop soni yoki CIDR ro'yxati. Bo'sh = o'chiq (X-Forwarded-For ga ishonilmaydi)
TRUST_PROXY=
# Prodda /docs ni ochish uchun maxfiy token (x-docs-token sarlavhasi, kamida 16 belgi); bo'sh bo'lsa prodda docs yopiq
DOCS_TOKEN=
# Ixtiyoriy: Google kirish (bo'sh bo'lsa 503 GOOGLE_DISABLED), platforma adminlari, fayl manzili
GOOGLE_CLIENT_ID=
PLATFORM_ADMIN_PHONES=+998901234567
API_PUBLIC_URL=http://localhost:4000
# Ixtiyoriy: Premium to'lov rekvizitlari (bank, hisob raqami); bo'sh bo'lsa placeholder
PREMIUM_PAY_DETAILS=
# Ixtiyoriy: Yordamchi LLM (Anthropic); bo'sh bo'lsa faqat lug'at parseri. Model va kunlik limitlar (mehmon 10, foydalanuvchi 100)
ANTHROPIC_API_KEY=
YORDAMCHI_MODEL=claude-sonnet-5
YORDAMCHI_GUEST_DAILY=10
YORDAMCHI_USER_DAILY=100

# Bot
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Ixtiyoriy: Mini App manzili (sukut WEB_URL + /tg); web_app tugmalar va menyu faqat https bilan
TG_APP_URL=

# Web
NEXT_PUBLIC_BOT_USERNAME=yuksaroy_bot
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
API_INTERNAL_URL=http://localhost:4000
